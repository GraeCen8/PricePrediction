import torch 
import math 
import torch.nn as nn 

class linearRegression(nn.Module): 
    def __init__(self, inFeatures, outFeatures, seq_len, paramScale):
        super(linearRegression, self).__init__()
        # y = ax + b
        self.L1 = nn.Linear(inFeatures * seq_len, 128 * paramScale, False)
        self.L2 = nn.Linear(128*paramScale, 256*paramScale, False)
        self.L3 = nn.Linear(256*paramScale, 128*paramScale, False)

        self.flatten = nn.Flatten()
        self.gelu = nn.GELU()

        self.out = nn.Linear(128*paramScale, outFeatures, False)

    def forward(self, X):
        X = self.flatten(X)
        X = self.L1(X)
        X = self.gelu(X)
        X = self.L2(X)
        X = self.gelu(X)
        X = self.L3(X)
        X = self.gelu(X)
        X = self.out(X)
        return X
    

